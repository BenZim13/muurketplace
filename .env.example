# Contrato HSCS del marketplace (vacío = no configurado; valor ficticio de ejemplo, solo Testnet)
MARKETPLACE_CONTRACT_ID=0.0.000000
# Espejo Supabase off-chain (spec 004, solo server-side, proyecto de test).
# Valores ficticios de formato: nunca URLs reales, claves reales, 0x ni PEM.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI
